{
    "$schema":  "https://schema.tauri.app/config/2",
    "productName":  "Orbiterm",
    "version":  "0.7.2",
    "identifier":  "com.orbiterm.app",
    "build":  {
                  "beforeDevCommand":  "npm run dev",
                  "devUrl":  "http://localhost:1420",
                  "beforeBuildCommand":  "npm run build",
                  "frontendDist":  "../build"
              },
    "app":  {
                "windows":  [
                                {
                                    "title":  "Orbiterm",
                                    "width":  1280,
                                    "height":  800,
                                    "minWidth":  800,
                                    "minHeight":  500,
                                    "dragDropEnabled":  true
                                }
                            ],
                "security":  {
                                 "csp":  "default-src \u0027self\u0027; style-src \u0027self\u0027 \u0027unsafe-inline\u0027; img-src \u0027self\u0027 data:; connect-src ipc: http://ipc.localhost ws://127.0.0.1:*"
                             }
            },
    "bundle":  {
                   "active":  true,
                   "targets":  "all",
                   "icon":  [
                                "icons/32x32.png",
                                "icons/128x128.png",
                                "icons/128x128@2x.png",
                                "icons/icon.icns",
                                "icons/icon.ico"
                            ]
               }
}
