{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orbiterm",
  "version": "0.7.7",
  "identifier": "com.orbiterm.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Orbiterm",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost ws://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "deb",
      "rpm"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Orbiterm",
    "category": "Utility",
    "shortDescription": "Terminal et client d’accès distant tout-en-un",
    "longDescription": "Orbiterm regroupe dans une seule fenêtre à onglets un terminal local, des sessions SSH (avec explorateur SFTP), RDP et VNC intégrés, Telnet, Rlogin, série, FTP, ainsi que des outils réseau et des serveurs intégrés.",
    "linux": {
      "deb": {
        "depends": [
          "libdbus-1-3"
        ],
        "recommends": [
          "gnome-keyring | kwalletmanager | keepassxc",
          "openssh-client"
        ],
        "section": "net",
        "desktopTemplate": "linux/orbiterm.desktop"
      },
      "rpm": {
        "depends": [
          "dbus-libs"
        ],
        "recommends": [
          "openssh-clients"
        ],
        "release": "1",
        "desktopTemplate": "linux/orbiterm.desktop"
      }
    }
  }
}
